# Copia este archivo como .env y completa los valores.

# Dirección del backend
VITE_API_URL=http://localhost:4000

# Llave pública de Wompi (en el panel de comercios de Wompi; empieza por pub_test_ en modo pruebas)
VITE_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxx

# Supabase (Project Settings > API; la llave publicable empieza por sb_publishable_)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
