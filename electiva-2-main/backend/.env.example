# Copia este archivo como .env (dentro de backend/) y completa los valores.

PORT=4000

# Wompi: secreto de integridad (panel de comercios → Desarrolladores → Secretos para integración técnica)
WOMPI_INTEGRITY_KEY=test_integrity_xxxxxxxxxxxxxxxxxxxx
# Opcional: por defecto se usa el sandbox. En producción: https://production.wompi.co/v1
# WOMPI_API_URL=https://sandbox.wompi.co/v1

# Clave para firmar las sesiones (mínimo 32 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cuenta de administrador que se crea la primera vez que arranca el backend
ADMIN_EMAIL=admin@movimarket.com
ADMIN_PASSWORD=cambia-esta-clave
