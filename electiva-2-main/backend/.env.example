# Copia este archivo como .env (dentro de backend/) y completa los valores.

PORT=4000

# Wompi: secreto de integridad (panel de comercios → Desarrolladores → Secretos para integración técnica)
WOMPI_INTEGRITY_KEY=test_integrity_xxxxxxxxxxxxxxxxxxxx
# Wompi: llave privada (mismo panel → Llaves del API; empieza por prv_test_ en modo pruebas).
# La usa el backend para revisar pagos que el widget no devolvió (PSE, Nequi, Bancolombia).
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxx
# Opcional: por defecto se usa el sandbox. En producción: https://production.wompi.co/v1
# WOMPI_API_URL=https://sandbox.wompi.co/v1

# Clave para firmar las sesiones (mínimo 32 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cuenta de administrador que se crea la primera vez que arranca el backend
ADMIN_EMAIL=admin@movimarket.com
ADMIN_PASSWORD=cambia-esta-clave

# Supabase (Project Settings → API Keys). La llave secreta empieza por sb_secret_:
# solo va aquí, nunca en el .env del frontend ni en GitHub.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Correos a clientes (confirmación de pedido y pedido enviado) por Gmail.
# GMAIL_APP_PASSWORD es una "contraseña de aplicación" de Google, no la contraseña normal:
# myaccount.google.com → Seguridad → Verificación en dos pasos → myaccount.google.com/apppasswords
# Sin estas dos variables la tienda funciona igual, pero no envía correos.
GMAIL_USER=tienda@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Correos por Brevo (brevo.com → SMTP & API → API Keys). Si está, se usa en vez de Gmail.
# Es la opción para Render: su plan gratuito bloquea SMTP y Gmail da "Connection timeout".
# El remitente es CORREO_REMITENTE o, si no está, GMAIL_USER; debe estar verificado en Brevo.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
# CORREO_REMITENTE=tienda@gmail.com
